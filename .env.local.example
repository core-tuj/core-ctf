# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Service role key: HANYA dipakai di server (API route / server action) untuk aksi admin.
# JANGAN pernah diberi prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Catatan: tidak ada FLAG_HASH_SALT. Flag di-hash dengan bcrypt (pgcrypto)
# di dalam database — salt per-baris digenerate oleh gen_salt('bf', 10), dan
# verifikasi terjadi di RPC submit_flag(). Plaintext flag tidak pernah
# meninggalkan Postgres.

# Base URL aplikasi (dipakai untuk callback OAuth Google)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
